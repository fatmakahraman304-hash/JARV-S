# ── J.A.R.V.I.S. — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# Local credentials and account state
/config/api_keys.json
/config/api_keys.json.*
/config/certs/
/config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# Personal data and generated reports
/memory/long_term.json
/memory/long_term.json.tmp
/memory/routines.json
/memory/routines.json.tmp
/memory/tasks/
memory/*.db
memory/*.db-*
/config/night_shift_report.*
/reports/
/uploads/
/.jarvis_backup/

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/

# Local updater transaction metadata and recovery copies
.jarvis-update*
.jarvis-backups/
*.jarvis-new
/config/coding_cooldown.json
/config/device_id
/config/jarvis_kurulum_qr.png
/config/shared_reminders.json
/tools/platform-tools/
/config/android_devices.json

# Computer-side extras (plugins/_pc_kit.py)
/memory/focus.json
/memory/screen_time.json
/memory/pc_extras.json
/memory/*.json.tmp
# hologram + Blender learning (personal, made on this PC)
/memory/holo_models.json
/memory/holo_glb/
/memory/holo_thumbs/
/memory/holo_current.glb
/memory/hand_landmarker.task
/memory/blender_lessons.json
/memory/blender_knowledge/
/memory/blender_live.token
/memory/blender_live_last.json
/memory/blender_preview.png
memory/away_digest*.json
memory/quiet.json
memory/recent_events.json
memory/last_briefing.json
memory/journal/
memory/home_timers.json
